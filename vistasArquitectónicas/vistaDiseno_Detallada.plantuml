@startuml VistaDiseno_Detallada
title Vista de Diseño de Componentes y Microservicios

' Configuración global para estilo y disposición
skinparam componentStyle rectangle
skinparam nodesep 20
skinparam ranksep 40
skinparam linetype polyline
skinparam DefaultTextAlignment center

' Paleta de colores basada en el diagrama original
skinparam component {
    BackgroundColor<<subsistema>> #FADBD8
    BackgroundColor<<microservicio>> #FADBD8
    BackgroundColor<<gateway>> #99CCFF
    BackgroundColor #FFFFFF
}

skinparam database {
    BackgroundColor White
}

' ==========================================
' CAPA SUPERIOR: WebUI y Microservicios Base
' ==========================================

component "WebUI" <<subsistema>> as WebUI #FADBD8 {
    component "SeguimientoBolsinPresWeb" as W_C1 #C4F5A3
    component "UsuarioPresWeb" as W_C2 #C4F5A3
    component "PaginaPricipalPresWeb" as W_C3 #C4F5A3
    
    ' Forzar apilamiento vertical interno
    W_C1 -[hidden]d-> W_C2
    W_C2 -[hidden]d-> W_C3
}

' ==========================================
' CAPA MEDIA: Gateways
' ==========================================
component "PublicAPIGateway" <<gateway>> as PAG
component "WebAPIGateway" <<gateway>> as WAG

' ==========================================
' INTERFACES: WebUI Sockets
' ==========================================
interface "IWebUIRestApi" as W_IWU
WebUI -u- W_IWU

' ==========================================
' INTERFACES: WebApiGateway Lollipops
' ==========================================
interface "IWebApiGateway" as WAG_IWU
WAG -u-( WAG_IWU
