@startuml usecaseDiagram
left to right direction

actor "Encargado de bolsines" as EB
actor "Gerente de comision medica" as GM
actor "Usuario" as U
actor "Servidor de Correo" as SC
actor "GPS Tracker" as GPS
actor "Servidor Google Maps" as SGM

usecase "19.Generar bolsin" as U19
usecase "20.Modificar bolsin" as U20
usecase "21.Eliminar bolsin" as U21
usecase "22.Consultar bolsin" as U22
usecase "5. Iniciar sesion" as U5
usecase "37. Generar reporte de bolsines en transito" as U37
usecase "38. Generar estadistica de movimiento de bolsines" as U38
usecase "27. Registrar el retiro de bolsines" as U27
usecase "29. Notificar recepción de bolsín" as U29
usecase "36. Consultar seguimiento de bolsines" as U36
usecase "28. Registrar recepción de bolsín" as U28

EB --|>U
GM --|>U

U --> U5
EB --> U19
EB --> U20
EB --> U21
EB --> U22
EB --> U27
EB --> U36
EB --> U28

U28 ..> U29 : <<extends>>

GM --> U37
GM --> U38

U29 --> SC
U36 --> SGM
U36 --> GPS

@enduml