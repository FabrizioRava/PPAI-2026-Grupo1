@startuml vistaDiseno_Global
title Vista de Diseño global

left to right direction
skinparam componentStyle rectangle

skinparam component {
  BackgroundColor<<gateway>> #85C1E9
  BackgroundColor<<microservicio>> #FADBD8
  BackgroundColor<<subsistema>> #F8F9F9
  BorderColor Black
}

skinparam database {
  BackgroundColor White
  BorderColor Black
}

skinparam rectangle {
  BackgroundColor transparent
  BorderColor Black
}

' ==========================================
' CAPA 1: Interfaces y Sistemas Externos
' ==========================================
component "WebUI" as WebUI <<subsistema>>

rectangle "Externos" as SistemasExternos {
  component "ServicioDispositivoGPS" as ServicioDispositivoGPS
  component "ServicioMapa" as ServicioMapa
  component "ServicioMailServer" as ServicioMailServer
  component "ServicioPowerBI" as ServicioPowerBI
}

' ==========================================
' CAPA 2: Gateways (Enrutamiento)
' ==========================================
component "WebAPIGateway" as WebGateway <<gateway>>
component "PublicAPIGateway" as PublicGateway <<gateway>>

' ==========================================
' CAPA 3: Microservicios y Bases de Datos
' ==========================================
component "ServicioSeguimientoBolsin" as SVC_SeguimientoBolsin <<microservicio>>
database "BD\nSeguimientoBolsin" as DB_SeguimientoBolsin

component "ServicioBolsin" as SVC_Bolsin <<microservicio>>
database "BD\nBolsin" as DB_Bolsin

component "ServicioComisionMedica" as SVC_ComisionMedica <<microservicio>>
database "BD\nComisionMedica" as DB_ComisionMedica

component "ServicioDocumentacion" as SVC_Documentacion <<microservicio>>
database "BD\nDocumentacion" as DB_Documentacion

component "ServicioUsuarios" as SVC_Usuarios <<microservicio>>
database "BD\nUsuarios" as DB_Usuarios

component "ServicioRemito" as SVC_Remito <<microservicio>>
database "BDRemito" as DB_Remito

component "IntegracionDispositivoGPS" as SVC_Integracion <<microservicio>>
component "IntegracionMapa" as SVC_IntegracionMapa <<microservicio>>
component "notificacionMail" as SVC_NotificacionMail <<microservicio>>
component "integracionPowerBI" as SVC_IntegracionPowerBI <<microservicio>>
' ==========================================
' RELACIONES: Acoplamiento de Bases de Datos
' ==========================================
' Se usa una línea sin flecha para denotar que la BD pertenece al servicio
SVC_SeguimientoBolsin - DB_SeguimientoBolsin
SVC_Bolsin - DB_Bolsin
SVC_ComisionMedica - DB_ComisionMedica
SVC_Documentacion - DB_Documentacion
SVC_Remito - DB_Remito
SVC_Usuarios - DB_Usuarios

' ==========================================
' RELACIONES: Flujo de solicitudes
' ==========================================
' Entradas a los Gateways
WebUI ---> WebGateway
ServicioDispositivoGPS ---> PublicGateway
ServicioMapa ---> PublicGateway
ServicioMailServer ---> PublicGateway
ServicioPowerBI ---> PublicGateway

' Distribución desde WebAPIGateway
WebGateway ---> SVC_SeguimientoBolsin
WebGateway ---> SVC_Bolsin
WebGateway ---> SVC_ComisionMedica
WebGateway ---> SVC_Documentacion
WebGateway ---> SVC_Usuarios
WebGateway ---> SVC_Remito

' Distribución desde PublicAPIGateway
PublicGateway --> SVC_Integracion
PublicGateway --> SVC_IntegracionMapa
PublicGateway --> SVC_NotificacionMail
PublicGateway --> SVC_IntegracionPowerBI

@enduml