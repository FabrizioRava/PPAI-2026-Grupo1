{
  "name": "ppai-backend",
  "version": "1.0.0",
  "description": "Backend para seguimiento de bolsines",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "nodemon --watch src -e ts --exec ts-node src/server.ts",
